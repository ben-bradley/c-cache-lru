{
  "name": "@ben-bradley/c-cache-lru",
  "version": "0.1.0",
  "description": "LRU storage adapter for c-cache (wraps lru-cache, implements CacheStorage)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "cache",
    "lru",
    "c-cache",
    "cluster",
    "worker",
    "storage",
    "adapter"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@ben-bradley/c-cache": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@ben-bradley/c-cache": {
      "optional": true
    }
  },
  "dependencies": {
    "lru-cache": "~10.4.3"
  },
  "devDependencies": {
    "@ben-bradley/c-cache": "^0.3.1",
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
